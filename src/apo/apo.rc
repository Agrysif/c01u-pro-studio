#include <winver.h>
#include "../shared/version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MS_VERSION_RC
 PRODUCTVERSION MS_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", MS_PUBLISHER
            VALUE "FileDescription", "C01U Pro Studio audio processing object"
            VALUE "FileVersion", MS_VERSION_STR
            VALUE "InternalName", "C01UProStudioApo"
            VALUE "LegalCopyright", MS_COPYRIGHT
            VALUE "OriginalFilename", "C01UProStudioApo.dll"
            VALUE "ProductName", MS_PRODUCT_NAME
            VALUE "ProductVersion", MS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
